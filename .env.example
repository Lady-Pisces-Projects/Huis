# Copy to .env.local for local development (or add each one to Replit Secrets).
# Never commit real values.

# Database — the app must connect as a login role that is a member of huis_app
# (NOT a superuser, NOT the table owner) so row-level security applies.
HUIS_DATABASE_URL=postgres://huis_app_login:change-me@localhost:5432/huis
# Used only by `npm run migrate` (schema owner / admin connection).
HUIS_MIGRATION_DATABASE_URL=postgres://postgres:change-me@localhost:5432/huis

# Public address of the app. Must match the redirect URI registered in Microsoft Entra:
#   <HUIS_BASE_URL>/api/auth/callback/microsoft
HUIS_BASE_URL=http://localhost:3000

# 32 random bytes, base64. Generate with: openssl rand -base64 32
HUIS_SESSION_SECRET=

# Microsoft Entra app registration "Huis Law" (development)
MICROSOFT_CLIENT_ID=834e42f3-7b16-4473-bb23-e9990b483139
# Paste from your password manager. Never commit or share in chat.
MICROSOFT_CLIENT_SECRET=

# ---- Evidence storage (Phase 2) ----
# Master key for per-firm evidence encryption (32 random bytes, base64).
# Production replaces this with a cloud key-management service.
HUIS_STORAGE_MASTER_KEY=
# Local folder for encrypted evidence during development.
# Production uses S3-compatible object storage.
HUIS_STORAGE_DIR=./.huis-storage
# Optional per-file limit in bytes (default 100 GB).
# HUIS_MAX_FILE_BYTES=

# ---- Evidence worker (run with `npm run worker`) ----
# Login role that is a member of huis_worker (can only call worker functions).
HUIS_WORKER_DATABASE_URL=postgres://huis_worker_login:change-me@localhost:5432/huis
# ClamAV daemon. Without it the worker refuses to start and files stay held.
HUIS_CLAMAV_HOST=127.0.0.1
HUIS_CLAMAV_PORT=3310

# Set to 1 only when running behind a trusted proxy/load balancer that
# appends the client IP to X-Forwarded-For (used for audit records).
# HUIS_TRUST_PROXY=1

# Text extraction needs these tools on the worker machine:
# poppler-utils (pdftotext, pdftoppm, pdfinfo), tesseract-ocr (+ eng), libreoffice (writer, calc, impress), ffmpeg, pst-utils (readpst), qpdf.

# ---- Sign in with Google, Gmail and Google Drive (Huis's Google OAuth app) ----
# Redirect URIs: <HUIS_BASE_URL>/api/auth/callback/google (Sign in with Google), <HUIS_BASE_URL>/api/mailboxes/google/callback (Gmail)
# and <HUIS_BASE_URL>/api/integrations/google_drive/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google Drive's file picker (Phase 9): a browser API key restricted to this site's address and the
# Picker API, and the Google Cloud project number (Project settings). Both are public values.
# GOOGLE_PICKER_API_KEY=
# GOOGLE_CLOUD_PROJECT_NUMBER=

# ---- Dropbox (Phase 9) ----
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=

# ---- Online payment: Stripe (Phase 10 part 2) ----
# In Stripe: a product "Huis Law" with two per-seat recurring prices ($237/month, $2,370/year).
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
# Webhook endpoint: <HUIS_BASE_URL>/api/stripe/webhook (signing secret below).
# STRIPE_WEBHOOK_SECRET=
# Login role that is a member of huis_billing (can only record Stripe's state for a firm).
# HUIS_BILLING_DATABASE_URL=postgres://huis_billing_login:change-me@localhost:5432/huis

# ---- Huis admin portal (Phase 10 part 6) ----
# Who is Huis staff: sign-in identity=Name, comma-separated (identity, never an email; see src/admin/staff.ts).
# HUIS_STAFF=google:109876543210987654321=Tracy Peart
# Login role that is a member of huis_platform (account functions only; no access to any Matter or document).
# HUIS_PLATFORM_DATABASE_URL=postgres://huis_platform_login:change-me@localhost:5432/huis

# Phase 10 part 2b: deleting unpaid trials 30 days after the trial ends (worker). OFF unless set to "on".
# Turn it on only once the terms of service and privacy policy say so. Warnings (14, 7 and 1 days before) go to
# the firm's owners by email; without an email service nothing is sent and nothing is ever deleted.
HUIS_TRIAL_DELETION=
# Outbound email (deletion warnings) through Resend. Leave empty until the sending service is decided.
RESEND_API_KEY=
HUIS_MAIL_FROM=
